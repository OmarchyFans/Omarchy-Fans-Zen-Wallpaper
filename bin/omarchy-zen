#!/bin/bash
#
# omarchy-zen — helper for the Zen Wallpaper plugin
# (fans.omarchy.zen-wallpaper). The engine inside omarchy-shell
# (Service.qml) and the bar chip (Widget.qml) call this for everything that
# touches the network or the disk; you can call it too.
#
#   omarchy-zen status [--json]          what is playing, the last still, the daily stamp
#   omarchy-zen set-url URL              use another YouTube video, live stream, playlist or channel
#   omarchy-zen mode animated|still|off  video under your windows, a still frame, or nothing
#   omarchy-zen sound on|off             play the stream's audio (also in still mode)
#   omarchy-zen volume 0..1              audio volume
#   omarchy-zen quality 480|720|1080     largest video height to decode
#   omarchy-zen daily-refresh on|off     a fresh still (and the newest video of a channel) every day
#   omarchy-zen daily-theme on|off       also rebuild the Aether theme every day
#   omarchy-zen fullscreen-pause on|off  pause while a window is fullscreen
#   omarchy-zen toggle-mode              animated <-> still (for a keybinding)
#   omarchy-zen pause | resume           pause or resume the engine
#   omarchy-zen position [save ID SECONDS]   where the stream is (the engine saves it every 30 s; a restart resumes there)
#   omarchy-zen resolve [--force]        ask yt-dlp for the stream URLs (cached until they expire)
#   omarchy-zen still [--at SEC] [--no-set]   grab one frame, make it the Omarchy background
#   omarchy-zen theme [--frame PATH] [--light] [--no-apply]   Aether palette from a frame -> Omarchy theme
#   omarchy-zen daily [--force]          the daily refresh (still, newest video, theme if enabled)
#   omarchy-zen open                     open the current video in the browser
#   omarchy-zen suno                     open the author's Suno invite (make your own music) in the browser
#   omarchy-zen library [--json] [--category ID | --channel REF | --bookmarks] [--refresh]
#                          [--kind K --sort S --filter TEXT --offset N --limit N]   (creator filters, with --channel)
#                                              the catalog (top 10 per category), a creator's latest, or your bookmarks,
#                                              with your stars, everyone's average and what is playing
#   omarchy-zen play ID|URL              play a library entry (a video id, a video URL or a creator's channel)
#   omarchy-zen bookmark [list|add [ID|URL]|remove ID|toggle [ID]]   bookmarks (no id = what is playing)
#   omarchy-zen rate ID|URL 1..5         rate a video (0 removes); shared with every install unless share_ratings is off
#   omarchy-zen share-ratings on|off     share your stars and plays (one per video and day) with every install
#   omarchy-zen ratings [--refresh]      everyone's averages (cached an hour)
#   omarchy-zen channel list [--json]          saved (bookmarked) creators plus the built-in ones
#   omarchy-zen channel add|toggle|remove [REF] [--json]   bookmark a creator: a channel URL, @handle, channel id,
#                                              or any of their video links; no REF = the creator of what is playing
#   omarchy-zen channel videos REF [--kind all|live|stream|upload] [--sort newest|popular|longest]
#                              [--filter TEXT] [--offset N] [--limit N] [--refresh] [--json]   browse a creator's catalog
#   omarchy-zen channel open [REF]             the creator's page in the browser
#   omarchy-zen catalog [--refresh]      the curated list (fetched from the main branch once a day)
#   omarchy-zen update-check|update-dismiss|update-run   see docs/update-alerts.md
#
# Files:
#   ~/.config/omarchy-zen/config.json          settings (this script writes it; the engine watches it)
#   ~/.local/state/omarchy-zen/stream.json     the resolved stream (URLs expire after a few hours)
#   ~/.local/state/omarchy-zen/frame.json      the last still
#   ~/.local/state/omarchy-zen/daily.json      when the daily refresh last ran
#   ~/.local/share/omarchy-zen/frames/         still frames (the newest twelve are kept)
#   ~/.config/omarchy/themes/<theme_name>/           the Aether theme, applied with omarchy-theme-set
#   ~/.config/omarchy-zen/bookmarks.json       your bookmarks; ratings.json your stars; channels.json creators you added
#   ~/.cache/omarchy-zen/catalog.json          the curated catalog (24 h); ratings.json everyone's averages (1 h)
#
# Network: yt-dlp talks to YouTube to resolve the stream, list a creator's
# videos and name a bookmark; ffmpeg fetches one frame for a still; the engine
# streams the video and audio from YouTube; catalog.json comes from this
# plugin's GitHub main branch; a rating (a random install id, the video id, the
# stars) goes to the ratings API named in the catalog when share_ratings is on.
# Nothing else leaves the machine (the update check is documented separately).
#
# Every tool comes from root-owned system folders, never the caller's PATH.
set -euo pipefail
export PATH="/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin"
ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
# Tests may put the plugin's own stubs first (tests/run.sh sets this to tests/stubs).
[[ -n ${DZ_TEST_STUBS:-} && $DZ_TEST_STUBS == "$ROOT/tests/stubs" ]] && PATH="$DZ_TEST_STUBS:$PATH"

VERSION=$(jq -r '.version // "dev"' "$ROOT/manifest.json" 2>/dev/null || echo dev)
# Daily Zen Wallpaper (0.3 and earlier) kept its files under omarchy-daily-zen: move them once.
for _base in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_STATE_HOME:-$HOME/.local/state}" "${XDG_DATA_HOME:-$HOME/.local/share}" "${XDG_CACHE_HOME:-$HOME/.cache}"; do
  [[ -d $_base/omarchy-daily-zen && ! -e $_base/omarchy-zen ]] && mv -- "$_base/omarchy-daily-zen" "$_base/omarchy-zen" 2>/dev/null
done
unset _base
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-zen"
CONFIG="$CONFIG_DIR/config.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-zen"
STREAM="$STATE_DIR/stream.json"
FRAME_STATE="$STATE_DIR/frame.json"
DAILY_STATE="$STATE_DIR/daily.json"
POSITION_STATE="$STATE_DIR/position.json"   # where the stream was, so a shell restart resumes there
FRAMES="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-zen/frames"
THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes"
DEFAULT_URL="https://www.youtube.com/watch?v=vFJuk4U-V7Q"
IPC_TARGET="zen"
KEEP_FRAMES=12

die() { echo "omarchy-zen: $*" >&2; exit 1; }
now() { date +%s; }

# HANCORE-linux's marketplace review (#7099 follow-up): every automatically
# invoked yt-dlp/ffmpeg call talks to remote YouTube data with no total
# deadline and no output ceiling, unlike the curl paths above (which already
# have --max-time/--max-filesize). A stalled or oversized remote response
# could hold the long-lived wallpaper service/helper indefinitely or exhaust
# its memory. `timeout -k` gives a real SIGKILL grace after SIGTERM so a
# yt-dlp/ffmpeg child that ignores the first signal is still reaped; each
# yt-dlp call site below also pipes through `head -c` so a runaway response
# can't grow a captured shell variable without bound.
YTDLP_TIMEOUT_SEC="${OMARCHY_ZEN_YTDLP_TIMEOUT:-25}"
YTDLP_MAX_BYTES="${OMARCHY_ZEN_YTDLP_MAX_BYTES:-4000000}"
FFMPEG_TIMEOUT_SEC="${OMARCHY_ZEN_FFMPEG_TIMEOUT:-20}"

# ffmpeg_bounded <ffmpeg args...> -> same exit status as ffmpeg, killed at
# FFMPEG_TIMEOUT_SEC (frame capture writes a file directly, no output to cap).
ffmpeg_bounded() { timeout -k 5 "$FFMPEG_TIMEOUT_SEC" ffmpeg "$@"; }

# ---- config ------------------------------------------------------------------
defaults() {
  jq -n --arg url "$DEFAULT_URL" '{
    url: $url, mode: "animated", sound: true, volume: 0.35, quality: 720,
    daily_refresh: true, daily_theme: false, theme_name: "zen",
    pause_when_fullscreen: true, screen: "", update_check: true,
    share_ratings: true, ratings_api: "", install_id: "" }'
}
config() {
  jq -s '.[0] * .[1]' <(defaults) <({ [[ -f $CONFIG ]] && jq . "$CONFIG" 2>/dev/null; } || echo '{}')
}
cfg() { config | jq -r --arg k "$1" '.[$k]'; }
config_set() { # config_set KEY JSON_VALUE
  local tmp
  mkdir -p "$CONFIG_DIR"
  tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX")
  if config | jq --arg k "$1" --argjson v "$2" '.[$k] = $v' >"$tmp"; then
    mv -f "$tmp" "$CONFIG"
  else
    rm -f "$tmp"; die "could not write $CONFIG"
  fi
}
write_json() { # write_json PATH  (stdin -> file, atomically)
  local tmp
  mkdir -p "$(dirname "$1")"
  tmp=$(mktemp "$(dirname "$1")/.tmp.XXXXXX")
  cat >"$tmp" && mv -f "$tmp" "$1"
}
onoff() { case "${1:-}" in on|true|1|yes) echo true ;; off|false|0|no) echo false ;; *) die "expected on or off, got '${1:-}'" ;; esac; }

# The running engine, if any. Best effort: no shell, no problem.
ipc() { command -v omarchy-shell >/dev/null 2>&1 || return 0; timeout 3 omarchy-shell -q "$IPC_TARGET" "$@" 2>/dev/null || true; }
ipc_get() { command -v omarchy-shell >/dev/null 2>&1 || return 0; timeout 3 omarchy-shell "$IPC_TARGET" "$@" 2>/dev/null || true; }

# ---- URLs --------------------------------------------------------------------
# Only YouTube, only https, only URL characters: the value is passed to yt-dlp
# after `--` and stored in JSON, never handed to a shell.
valid_url() {
  local u=$1
  LC_ALL=C; [[ $u =~ ^https://(www\.|m\.|music\.)?(youtube\.com|youtu\.be)/[A-Za-z0-9._~:/?#@!\$\&\'\(\)\*\+,\;=%-]*$ ]]
}
source_kind() { # video | playlist | channel
  local u=${1%/}
  case "$u" in
    *"/watch?"*|*"youtu.be/"*|*"/live/"*|*"/shorts/"*|*"/embed/"*) echo video ;;
    *"list="*|*"/playlist"*) echo playlist ;;
    *"/@"*|*"/channel/"*|*"/c/"*|*"/user/"*) echo channel ;;
    *) echo video ;;
  esac
}
# The newest entry of a playlist or channel. Channels: the streams tab first
# (that is where the long mood streams live), then the uploads.
newest_video_id() { # newest_video_id URL KIND
  local url=${1%/} kind=$2 id cand
  local -a cands=()
  case "$kind" in
    playlist) cands=("$url") ;;
    channel)
      url=${url%/videos}; url=${url%/streams}; url=${url%/live}
      cands=("$url/streams" "$url/videos") ;;
  esac
  for cand in "${cands[@]}"; do
    id=$(timeout -k 5 "$YTDLP_TIMEOUT_SEC" yt-dlp --no-warnings --flat-playlist --playlist-items 1 --print id -- "$cand" 2>/dev/null | head -c 200 | head -n1 || true)
    if [[ $id =~ ^[A-Za-z0-9_-]{6,}$ ]]; then echo "$id"; return 0; fi
  done
  return 1
}
url_expiry() { # the googlevideo URLs carry their expiry; default five hours
  local u=$1
  if [[ $u =~ /expire/([0-9]{9,11})(/|$) ]] || [[ $u =~ [?\&]expire=([0-9]{9,11}) ]]; then echo "${BASH_REMATCH[1]}"; else echo $(( $(now) + 5 * 3600 )); fi
}

# Pick one video and one audio format for the engine. HLS (m3u8) first: the
# stream starts fast and seeks by segment. avc1 before vp9: hardware decoders
# and Qt's ffmpeg backend both like it. Height capped at the configured
# quality; without a small enough format the smallest one wins.
FORMAT_JQ='
  def hls: [.formats[] | select((.protocol // "") | startswith("m3u8"))];
  def plain: [.formats[] | select(.protocol == "https" or .protocol == "http")];
  def vids(fs): [fs[] | select(.vcodec != null and .vcodec != "none" and (.height // 0) > 0 and .url != null)];
  def pickv(fs; q):
    (vids(fs)) as $v
    | ( [$v[] | select((.height // 0) <= q and ((.vcodec // "") | startswith("avc1")))] | sort_by(.height, .tbr // 0) | last )
      // ( [$v[] | select((.height // 0) <= q)] | sort_by(.height, .tbr // 0) | last )
      // ( $v | sort_by(.height) | first );
  def picka(fs): ( [fs[] | select((.vcodec == null or .vcodec == "none") and (.acodec == null or .acodec != "none") and .height == null and .url != null)]
                   | sort_by((if ((.acodec // "") | startswith("mp4a")) then 1 else 0 end), (.tbr // .abr // 0)) | last );
  (hls) as $h | (plain) as $p
  | (pickv($h; $q) // pickv($p; $q)) as $v
  | (if (($v.protocol // "") | startswith("m3u8")) then (picka($h) // picka($p)) else (picka($p) // picka($h)) end) as $a
  | { source_url: $src, source_kind: $kind, video_id: .id, title: (.title // ""), channel: (.channel // .uploader // ""),
      channel_id: (.channel_id // ""), channel_handle: (.uploader_id // ""), channel_url: (.uploader_url // .channel_url // ""),
      webpage_url: (.webpage_url // ""), duration: (.duration // 0), is_live: (.is_live // false), quality: $q,
      video_url: ($v.url // ""), video_height: ($v.height // 0), video_format: ($v.format_id // ""), video_protocol: ($v.protocol // ""),
      audio_url: ($a.url // ""), audio_format: ($a.format_id // ""), resolved_at: $now, expires: 0 }
'

# The stream plus resume_position: the saved position when it is for this
# video (a live stream has no position to return to).
with_resume() {
  local pos=0
  if [[ -f $POSITION_STATE ]]; then
    pos=$(jq -r --arg id "$(jq -r .video_id "$1")" 'if .video_id == $id then (.position // 0) else 0 end' "$POSITION_STATE" 2>/dev/null || echo 0)
  fi
  [[ $pos =~ ^[0-9]+$ ]] || pos=0
  jq --argjson p "$pos" '.resume_position = (if .is_live then 0 else $p end)' "$1"
}
cmd_position() {
  if [[ ${1:-} == save ]]; then
    local id=${2:-} sec=${3:-}
    (LC_ALL=C; [[ $id =~ ^[A-Za-z0-9_-]{11}$ ]]) || die "position save wants a video id"
    [[ $sec =~ ^[0-9]+$ ]] || die "position save wants seconds"
    jq -n --arg id "$id" --argjson p "$sec" --argjson at "$(now)" '{video_id: $id, position: $p, at: $at}' | write_json "$POSITION_STATE"
    return 0
  fi
  if [[ -f $POSITION_STATE ]]; then jq -r '"\(.video_id) at \(.position) s (\(.at))"' "$POSITION_STATE"; else echo "no position saved"; fi
}

cmd_resolve() {
  local force=0 json=0 quiet=0 a url kind quality watch id info out
  for a in "$@"; do case "$a" in --force) force=1 ;; --json) json=1 ;; --quiet) quiet=1 ;; *) die "resolve: unknown option $a" ;; esac; done
  url=$(cfg url); quality=$(cfg quality)
  valid_url "$url" || die "not a YouTube URL: $url"
  [[ $quality =~ ^[0-9]+$ ]] || quality=720
  mkdir -p "$STATE_DIR"
  # One resolve at a time (the engine and a still can ask together). The lock
  # is released before returning: still and daily call resolve from subshells.
  exec 9>"$STATE_DIR/.lock"; flock 9
  if (( ! force )) && [[ -f $STREAM ]] \
     && jq -e --arg u "$url" --argjson q "$quality" --argjson now "$(now)" \
          '.source_url == $u and .quality == $q and .video_url != "" and (.expires - 900) > $now' "$STREAM" >/dev/null 2>&1; then
    exec 9>&-
    (( json )) && with_resume "$STREAM"
    (( quiet || json )) || jq -r '"\(.title) — \(.channel) (\(.video_height)p, cached)"' "$STREAM"
    return 0
  fi
  kind=$(source_kind "$url")
  if [[ $kind == video ]]; then
    watch=$url
  else
    id=$(newest_video_id "$url" "$kind") || die "no video found at $url"
    watch="https://www.youtube.com/watch?v=$id"
  fi
  info=$(timeout -k 5 "$YTDLP_TIMEOUT_SEC" yt-dlp --no-warnings --no-playlist -j -- "$watch" 2>&1 | head -c "$YTDLP_MAX_BYTES") || die "yt-dlp: ${info##*$'\n'}"
  out=$(jq -c --arg src "$url" --arg kind "$kind" --argjson q "$quality" --argjson now "$(now)" "$FORMAT_JQ" <<<"$info") || die "could not read the yt-dlp answer"
  [[ $(jq -r .video_url <<<"$out") != "" ]] || die "no playable video format at $watch"
  out=$(jq -c --argjson exp "$(url_expiry "$(jq -r .video_url <<<"$out")")" '.expires = $exp' <<<"$out")
  write_json "$STREAM" <<<"$out"
  exec 9>&-
  (( json )) && with_resume "$STREAM"
  (( quiet || json )) || jq -r '"\(.title) — \(.channel) (\(.video_height)p\(if .is_live then ", live" else "" end))"' "$STREAM"
}

# ---- still -------------------------------------------------------------------
prune_frames() {
  local f n=0
  while IFS= read -r f; do
    n=$((n + 1))
    if (( n > KEEP_FRAMES )); then rm -f -- "$f"; fi
  done < <(ls -1t -- "$FRAMES"/*.png 2>/dev/null || true)
  return 0
}
cmd_still() {
  local at="" set=1 json=0 quiet=0 a video_url duration is_live id out
  while (( $# )); do
    case "$1" in
      --at) at=${2:-}; shift ;;
      --random) at="" ;;
      --no-set) set=0 ;;
      --json) json=1 ;;
      --quiet) quiet=1 ;;
      *) die "still: unknown option $1" ;;
    esac; shift
  done
  cmd_resolve --quiet
  video_url=$(jq -r .video_url "$STREAM"); duration=$(jq -r '.duration // 0' "$STREAM")
  is_live=$(jq -r '.is_live' "$STREAM"); id=$(jq -r .video_id "$STREAM")
  [[ $id =~ ^[A-Za-z0-9_-]+$ ]] || id=video
  duration=${duration%.*}; [[ $duration =~ ^[0-9]+$ ]] || duration=0
  if [[ $is_live == true ]]; then
    at=""
  elif [[ -z $at ]] && (( duration > 30 )); then
    # anywhere in the middle 96 %: not the intro card, not the outro
    at=$(( duration * 2 / 100 + RANDOM * (duration * 96 / 100) / 32768 ))
  fi
  [[ -z $at || $at =~ ^[0-9]+$ ]] || die "still: --at wants seconds"
  mkdir -p "$FRAMES"
  out="$FRAMES/${id}-$(date +%Y%m%d-%H%M%S)${at:+-at$at}.png"
  local -a seek=(); [[ -n $at ]] && seek=(-ss "$at")
  # -- is not an ffmpeg thing; the URL starts with https:// and the output with /.
  ffmpeg_bounded -v error -y -nostdin "${seek[@]}" -i "$video_url" -frames:v 1 -q:v 2 "$out" </dev/null \
    || die "ffmpeg could not grab a frame (the stream URL may have expired: try 'omarchy-zen resolve --force')"
  [[ -s $out ]] || die "ffmpeg wrote no frame"
  prune_frames
  jq -n --arg path "$out" --arg id "$id" --arg at "${at:-}" --argjson taken "$(now)" \
    '{path: $path, video_id: $id, at: (if $at == "" then null else ($at | tonumber) end), taken: $taken}' | write_json "$FRAME_STATE"
  if (( set )); then
    omarchy-theme-bg-set "$out" >/dev/null 2>&1 || echo "omarchy-zen: omarchy-theme-bg-set failed; the frame is at $out" >&2
  fi
  if (( json )); then cat "$FRAME_STATE"; elif (( ! quiet )); then echo "$out"; fi
}

# ---- theme -------------------------------------------------------------------
cmd_theme() {
  local frame="" apply=1 light=0 json=0 name tmp dest
  while (( $# )); do
    case "$1" in
      --frame) frame=${2:-}; shift ;;
      --no-apply) apply=0 ;;
      --light) light=1 ;;
      --json) json=1 ;;
      *) die "theme: unknown option $1" ;;
    esac; shift
  done
  command -v aether >/dev/null 2>&1 || die "aether is not installed (it ships with Omarchy; install the aether package)"
  if [[ -z $frame ]]; then
    frame=$(jq -r '.path // ""' "$FRAME_STATE" 2>/dev/null || true)
    [[ -n $frame && -f $frame ]] || frame=$(cmd_still --no-set)
  fi
  [[ -f $frame ]] || die "no such frame: $frame"
  name=$(cfg theme_name)
  (LC_ALL=C; [[ $name =~ ^[a-z0-9_][a-z0-9._+-]*$ ]]) || die "theme_name '$name' is not a usable theme name"
  tmp=$(mktemp -d)
  local -a opts=(); (( light )) && opts=(--light-mode)
  if ! aether --generate "$frame" --no-apply --output "$tmp" "${opts[@]}" >/dev/null 2>"$tmp/.err"; then
    local err; err=$(tail -n1 "$tmp/.err" 2>/dev/null || true); rm -rf "$tmp"; die "aether failed: ${err:-no message}"
  fi
  [[ -f $tmp/colors.toml ]] || { rm -rf "$tmp"; die "aether wrote no colors.toml"; }
  # Only the palette and the picture. Everything else Aether renders (terminal
  # configs, hyprland.conf, ...) would shadow the files omarchy-theme-set
  # generates from colors.toml for Omarchy 4.
  dest="$THEMES_DIR/$name"
  mkdir -p "$dest/backgrounds"
  rm -f -- "$dest"/backgrounds/*
  cp -- "$tmp/colors.toml" "$dest/colors.toml"
  cp -- "$frame" "$dest/backgrounds/$(basename -- "$frame")"
  cp -- "$frame" "$dest/preview.png"
  printf '# %s\n\nMade by Zen Wallpaper (fans.omarchy.zen-wallpaper): Aether extracted this palette from\n%s\n\nRegenerate with: omarchy-zen theme\n' "$name" "$frame" >"$dest/README.md"
  rm -rf "$tmp"
  if (( apply )); then
    omarchy-theme-set "$name" >/dev/null 2>&1 || echo "omarchy-zen: omarchy-theme-set $name failed; the theme is at $dest" >&2
  fi
  if (( json )); then
    jq -n --arg name "$name" --arg dir "$dest" --arg frame "$frame" --argjson applied "$([[ $apply == 1 ]] && echo true || echo false)" \
      '{theme: $name, dir: $dir, frame: $frame, applied: $applied}'
  else
    echo "$dest"
  fi
}

# ---- daily -------------------------------------------------------------------
cmd_daily() {
  local force=0 a last frame before after
  for a in "$@"; do case "$a" in --force) force=1 ;; *) die "daily: unknown option $a" ;; esac; done
  if (( ! force )) && [[ $(cfg daily_refresh) != true ]]; then echo "daily refresh is off"; return 0; fi
  last=$(jq -r '.last // 0' "$DAILY_STATE" 2>/dev/null || echo 0); [[ $last =~ ^[0-9]+$ ]] || last=0
  if (( ! force )) && (( $(now) - last < 86400 )); then echo "already refreshed today"; return 0; fi
  before=$(jq -r '.video_id // ""' "$STREAM" 2>/dev/null || true)
  cmd_resolve --force --quiet
  after=$(jq -r '.video_id // ""' "$STREAM")
  [[ -n $after && $after != "$before" ]] && report_play "$after"
  frame=$(cmd_still --quiet; jq -r .path "$FRAME_STATE")
  if [[ $(cfg daily_theme) == true ]]; then cmd_theme --frame "$frame" >/dev/null; fi
  jq -n --argjson last "$(now)" --arg frame "$frame" --arg id "$after" '{last: $last, frame: $frame, video_id: $id}' | write_json "$DAILY_STATE"
  catalog_file 1 >/dev/null; sync_pending
  # A new video (channels, playlists) starts playing; the same video keeps playing.
  ipc refresh
  echo "$frame"
}

# ---- status ------------------------------------------------------------------
cmd_status() {
  local json=0 a engine
  for a in "$@"; do case "$a" in --json) json=1 ;; *) die "status: unknown option $a" ;; esac; done
  engine=$(ipc_get status); [[ -n $engine ]] && jq -e . <<<"$engine" >/dev/null 2>&1 || engine=null
  local out
  out=$(jq -n --arg version "$VERSION" --argjson config "$(config)" \
    --argjson stream "$( [[ -f $STREAM ]] && jq '{title, channel, video_id, is_live, video_height, video_format, audio_format, expires, resolved_at, webpage_url, source_kind, duration}' "$STREAM" || echo null)" \
    --argjson frame "$( [[ -f $FRAME_STATE ]] && cat "$FRAME_STATE" || echo null)" \
    --argjson daily "$( [[ -f $DAILY_STATE ]] && cat "$DAILY_STATE" || echo null)" \
    --argjson engine "$engine" --argjson now "$(now)" \
    '{version: $version, config: $config, stream: $stream, frame: $frame, daily: $daily, engine: $engine, now: $now}')
  if (( json )); then echo "$out"; return 0; fi
  jq -r '
    "Zen Wallpaper \(.version)",
    "  stream:  \(.config.url)",
    "  playing: \(if .stream then "\(.stream.title) — \(.stream.channel) (\(.stream.video_height)p\(if .stream.is_live then ", live" else "" end))" else "not resolved yet" end)",
    "  engine:  \(if .engine then "\(.engine.state)\(if .engine.error != "" then " — " + .engine.error else "" end)" else "not running (is the plugin enabled?)" end)",
    "  mode:    \(.config.mode), sound \(if .config.sound then "on" else "off" end) at \(.config.volume), up to \(.config.quality)p",
    "  daily:   refresh \(if .config.daily_refresh then "on" else "off" end), theme \(if .config.daily_theme then "on" else "off" end)\(if .daily then ", last " + ((.now - .daily.last) / 3600 | floor | tostring) + " h ago" else "" end)",
    "  still:   \(if .frame then .frame.path else "none yet" end)"
  ' <<<"$out"
}

cmd_set_url() {
  local url=${1:-}
  [[ -n $url ]] || die "set-url wants a URL"
  valid_url "$url" || die "only https YouTube links (youtube.com, youtu.be, music.youtube.com) are accepted"
  local before after
  before=$(jq -r '.video_id // ""' "$STREAM" 2>/dev/null || true)
  config_set url "$(jq -n --arg u "$url" '$u')"
  rm -f "$STREAM" "$POSITION_STATE"
  ipc reload
  cmd_resolve --quiet && cmd_resolve
  after=$(jq -r '.video_id // ""' "$STREAM" 2>/dev/null || true)
  [[ -n $after && $after != "$before" ]] && report_play "$after"
  return 0
}

SUNO_INVITE="https://suno.com/invite/@markusix"
cmd_suno() { setsid -f xdg-open "$SUNO_INVITE" >/dev/null 2>&1 </dev/null; }

cmd_open() {
  local u; u=$(jq -r '.webpage_url // ""' "$STREAM" 2>/dev/null || true); [[ -n $u ]] || u=$(cfg url)
  valid_url "$u" || die "nothing to open"
  setsid -f xdg-open "$u" >/dev/null 2>&1 </dev/null
}

# ---- library: catalog, creators, bookmarks, ratings ---------------------------
CATALOG_RAW="${OMARCHY_ZEN_RAW:-https://raw.githubusercontent.com/OmarchyFans/Omarchy-Fans-Zen-Wallpaper/main}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-zen"
CATALOG_CACHE="$CACHE_DIR/catalog.json"
RATINGS_CACHE="$CACHE_DIR/ratings.json"
CHANNEL_CACHE="$CACHE_DIR/channels"
BOOKMARKS="$CONFIG_DIR/bookmarks.json"
MY_RATINGS="$CONFIG_DIR/ratings.json"
MY_CHANNELS="$CONFIG_DIR/channels.json"
CATALOG_TTL=${OMARCHY_ZEN_CATALOG_TTL:-86400}
RATINGS_TTL=${OMARCHY_ZEN_RATINGS_TTL:-3600}
CHANNEL_TTL=${OMARCHY_ZEN_CHANNEL_TTL:-21600}

fetch() { curl -fsS --max-time 8 --max-filesize 3000000 -A "omarchy-zen/$VERSION" "$@"; }
fresh() { [[ -f $1 ]] && (( $(now) - $(stat -c %Y -- "$1") < $2 )); }
json_file_or() { # json_file_or FILE JQ_TYPE_TEST DEFAULT
  if [[ -f $1 ]] && jq -e "$2" "$1" >/dev/null 2>&1; then cat "$1"; else echo "$3"; fi
}
# The curated catalog: refreshed from the main branch once a day, the bundled
# copy when nothing was ever fetched. A failed fetch keeps the old file a day.
catalog_file() {
  local refresh=${1:-0} tmp
  if (( refresh )) || ! fresh "$CATALOG_CACHE" "$CATALOG_TTL"; then
    mkdir -p "$CACHE_DIR"; tmp=$(mktemp "$CACHE_DIR/.catalog.XXXXXX")
    if fetch "$CATALOG_RAW/catalog.json" >"$tmp" 2>/dev/null && jq -e '.schema == 1 and (.categories | type == "array")' "$tmp" >/dev/null 2>&1; then
      mv -f "$tmp" "$CATALOG_CACHE"
    else
      rm -f "$tmp"; [[ -f $CATALOG_CACHE ]] && touch "$CATALOG_CACHE"
    fi
  fi
  if [[ -f $CATALOG_CACHE ]]; then echo "$CATALOG_CACHE"; else echo "$ROOT/catalog.json"; fi
}
ratings_api() {
  local a=${OMARCHY_ZEN_RATINGS_API:-}
  [[ -n $a ]] || a=$(cfg ratings_api)
  [[ -n $a && $a != null ]] || a=$(jq -r '.ratings_api // ""' "$(catalog_file)")
  (LC_ALL=C; [[ $a =~ ^https://[A-Za-z0-9._-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$ || $a =~ ^http://127\.0\.0\.1(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$ ]]) || return 1
  echo "${a%/}"
}
install_id() {
  local id; id=$(cfg install_id)
  if (LC_ALL=C; [[ ! $id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]); then
    id=$(cat /proc/sys/kernel/random/uuid); config_set install_id "$(jq -n --arg i "$id" '$i')"
  fi
  echo "$id"
}
community_ratings() {
  local refresh=${1:-0} api tmp
  api=$(ratings_api) || { echo '{}'; return 0; }
  if (( refresh )) || ! fresh "$RATINGS_CACHE" "$RATINGS_TTL"; then
    mkdir -p "$CACHE_DIR"; tmp=$(mktemp "$CACHE_DIR/.ratings.XXXXXX")
    if fetch "$api/v1/ratings" >"$tmp" 2>/dev/null && jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
      mv -f "$tmp" "$RATINGS_CACHE"
    else
      rm -f "$tmp"; [[ -f $RATINGS_CACHE ]] && touch "$RATINGS_CACHE"
    fi
  fi
  json_file_or "$RATINGS_CACHE" 'type == "object"' '{}'
}
video_id_of() { # video_id_of ID|URL -> the 11-character id
  local r=$1
  LC_ALL=C
  if [[ $r =~ ^[A-Za-z0-9_-]{11}$ ]]; then echo "$r"; return 0; fi
  if [[ $r =~ [?\&]v=([A-Za-z0-9_-]{11}) ]] || [[ $r =~ youtu\.be/([A-Za-z0-9_-]{11}) ]] || [[ $r =~ /(live|shorts|embed)/([A-Za-z0-9_-]{11}) ]]; then
    echo "${BASH_REMATCH[${#BASH_REMATCH[@]}-1]}"; return 0
  fi
  return 1
}
channel_id_of() { # channel_id_of URL|ID -> handle (without @) or channel id
  local r=$1
  LC_ALL=C
  if [[ $r =~ youtube\.com/@([A-Za-z0-9._-]+) ]]; then echo "${BASH_REMATCH[1]}"; return 0; fi
  if [[ $r =~ youtube\.com/(channel|c|user)/([A-Za-z0-9_-]+) ]]; then echo "${BASH_REMATCH[2]}"; return 0; fi
  if [[ $r =~ ^[A-Za-z0-9._-]{2,}$ && $r != *"/"* ]]; then echo "$r"; return 0; fi
  return 1
}
bookmarks_json() { json_file_or "$BOOKMARKS" 'type == "array"' '[]'; }
my_ratings_json() { json_file_or "$MY_RATINGS" 'type == "object"' '{}'; }
my_channels_json() { json_file_or "$MY_CHANNELS" 'type == "array"' '[]'; }
# Every creator the selector shows: the ones you bookmarked (channels.json,
# oldest first) and the built-in ones from the catalog. One record per creator
# even when it arrived once as @handle and once as a channel id.
CHANNELS_JQ='
  def ckey: ((.channel_id // "") | if . == "" then null else . end);
  def same($a; $b): ($a | ckey) as $x | ($b | ckey) as $y
    | (($x != null and $x == $y) or ((($a.id // "") | ascii_downcase) == (($b.id // "") | ascii_downcase)));
  (.[0] | map(. + {builtin: true, bookmarked: false})) as $cat
  | (.[1] | map(. + {bookmarked: true, builtin: false})) as $mine
  | reduce ($mine + $cat)[] as $c ([];
      (map(same(.; $c)) | index(true)) as $i
      | if $i == null then . + [$c]
        else .[$i] |= (. + {builtin: (.builtin or $c.builtin),
                              channel_id: ((.channel_id // "") | if . == "" then ($c.channel_id // "") else . end),
                              followers: ((.followers // 0) | if . == 0 then ($c.followers // 0) else . end),
                              note: (.note // $c.note // "")}) end)
  | map(. + {handle: ((.handle // "") | if . != "" then . else "" end), followers: (.followers // 0), channel_id: (.channel_id // "")})
  | map(if .handle == "" and ((.url // "") | test("/@[A-Za-z0-9._-]+$")) then .handle = ("@" + (.url | capture("/@(?<h>[A-Za-z0-9._-]+)$").h)) else . end)'
channels_json() { jq -s "$CHANNELS_JQ" <(jq '.channels // []' "$(catalog_file)") <(my_channels_json); }
# The record for a creator reference (id, @handle, channel id, or a URL of
# theirs), among the saved and built-in ones.
find_channel() {
  local ref=$1 cid="" hid=""
  LC_ALL=C
  [[ $ref =~ (UC[A-Za-z0-9_-]{22}) ]] && cid=${BASH_REMATCH[1]}
  [[ $ref =~ (^|/)@([A-Za-z0-9._-]+) ]] && hid=${BASH_REMATCH[2]}
  [[ -z $hid && -z $cid ]] && hid=$(channel_id_of "$ref" 2>/dev/null || true)
  channels_json | jq -ce --arg cid "$cid" --arg h "$hid" --arg ref "${ref%/}" '
    first(.[] | select(($cid != "" and .channel_id == $cid)
      or ($h != "" and (((.id // "") | ascii_downcase) == ($h | ascii_downcase) or ((.handle // "") | ascii_downcase) == ("@" + ($h | ascii_downcase))))
      or ((.url // "") == $ref)))' 2>/dev/null
}
CHANNEL_MAX=${OMARCHY_ZEN_CHANNEL_MAX:-300}
CATALOG_TIMEOUT_SEC=${OMARCHY_ZEN_CATALOG_TIMEOUT:-60}
CATALOG_MAX_BYTES=${OMARCHY_ZEN_CATALOG_MAX_BYTES:-8000000}
# Ask YouTube who a reference belongs to: a channel URL, @handle or channel id
# (one small playlist request), or a video (its uploader). Prints a record
# {id, name, url, channel_id, handle, followers}. Bounded like every yt-dlp call.
channel_resolve() {
  local ref=$1 vid url="" meta cid="" handle="" name="" followers=0 id
  LC_ALL=C
  if vid=$(video_id_of "$ref"); then
    meta=$(timeout -k 5 "$YTDLP_TIMEOUT_SEC" yt-dlp --no-warnings --skip-download --no-playlist \
             --print '%(channel_id)s	%(uploader_id)s	%(channel)s	%(channel_follower_count)s' -- "https://www.youtube.com/watch?v=$vid" 2>/dev/null \
           | head -c 4096 | head -n1 || true)
  else
    if [[ $ref =~ ^@[A-Za-z0-9._-]+$ ]]; then url="https://www.youtube.com/$ref"
    elif [[ $ref =~ ^UC[A-Za-z0-9_-]{22}$ ]]; then url="https://www.youtube.com/channel/$ref"
    elif [[ $ref =~ ^[A-Za-z0-9._-]{3,100}$ ]]; then url="https://www.youtube.com/@$ref"
    elif valid_url "$ref"; then url=$(sed -E 's#/+$##; s#/(videos|streams|live|featured|shorts|playlists|community|about)$##' <<<"$ref")
    else return 1; fi
    meta=$(timeout -k 5 "$YTDLP_TIMEOUT_SEC" yt-dlp --no-warnings --flat-playlist --playlist-items 1 -J -- "$url/videos" 2>/dev/null \
           | head -c "$YTDLP_MAX_BYTES" \
           | jq -r '[(.channel_id // .playlist_channel_id // ""), (.uploader_id // ""), (.channel // .uploader // ""), ((.channel_follower_count // 0) | tostring)] | @tsv' 2>/dev/null || true)
  fi
  IFS=$'\t' read -r cid handle name followers <<<"$meta"
  [[ $cid =~ ^UC[A-Za-z0-9_-]{22}$ ]] || return 1
  [[ $handle =~ ^@[A-Za-z0-9._-]+$ ]] || handle=""
  [[ $followers =~ ^[0-9]+$ ]] || followers=0
  if [[ -n $handle ]]; then id=${handle#@}; url="https://www.youtube.com/$handle"; else id=$cid; url="https://www.youtube.com/channel/$cid"; fi
  jq -nc --arg id "$id" --arg n "${name:-$id}" --arg u "$url" --arg c "$cid" --arg h "$handle" --argjson f "$followers" \
    '{id: $id, name: $n, url: $u, channel_id: $c, handle: $h, followers: $f}'
}
channel_key() { jq -r '(.channel_id // "") as $c | if $c != "" then $c else .id end' <<<"$1"; }
# A creator's catalog: live now, past streams and uploads (up to CHANNEL_MAX
# per tab, newest first as YouTube lists them, shorts under a minute left
# out), cached CHANNEL_TTL. Prints the cache file's path; the file is an
# array with one entry per video, tagged kind live|stream|upload.
channel_catalog() { # channel_catalog RECORD_JSON [refresh]
  local rec=$1 refresh=${2:-0} url key f tmp raw
  url=$(jq -r .url <<<"$rec"); key=$(channel_key "$rec")
  valid_url "$url" || die "no usable URL for this creator"
  [[ $key =~ ^[A-Za-z0-9._-]+$ ]] || die "bad creator id"
  mkdir -p "$CHANNEL_CACHE"
  f="$CHANNEL_CACHE/$key.v2.json"
  if (( refresh )) || ! fresh "$f" "$CHANNEL_TTL"; then
    tmp=$(mktemp "$CHANNEL_CACHE/.$key.XXXXXX"); raw=$(mktemp "$CHANNEL_CACHE/.$key.raw.XXXXXX")
    { timeout -k 5 "$CATALOG_TIMEOUT_SEC" yt-dlp --no-warnings --flat-playlist --playlist-items "1-$CHANNEL_MAX" -j -- "$url/streams" 2>/dev/null \
        | jq -c '. + {__tab: "streams"}' 2>/dev/null || true
      timeout -k 5 "$CATALOG_TIMEOUT_SEC" yt-dlp --no-warnings --flat-playlist --playlist-items "1-$CHANNEL_MAX" -j -- "$url/videos" 2>/dev/null \
        | jq -c '. + {__tab: "videos"}' 2>/dev/null || true; } | head -c "$CATALOG_MAX_BYTES" >"$raw"
    jq -sc --arg curl "$url" --arg cname "$(jq -r .name <<<"$rec")" --arg cid "$(jq -r '.channel_id // ""' <<<"$rec")" '
      [ .[] | select(.id != null and (.live_status // "") != "is_upcoming")
        | (if .live_status == "is_live" then "live" elif .__tab == "streams" or .live_status == "was_live" then "stream" else "upload" end) as $k
        | select($k == "live" or (.duration // 0) == 0 or (.duration // 0) >= 60)
        | {id, title: (.title // ""), channel: (.playlist_channel // .channel // .uploader // $cname), channel_url: $curl,
           channel_id: (.playlist_channel_id // .channel_id // $cid), url: ("https://www.youtube.com/watch?v=" + .id),
           live: ($k == "live"), kind: $k, duration: ((.duration // 0) | floor), views: (.view_count // 0),
           viewers: (.concurrent_view_count // 0), order: (.playlist_index // 0)} ]
      | reduce .[] as $e ([]; if any(.[]; .id == $e.id) then . else . + [$e] end)' "$raw" >"$tmp" 2>/dev/null || true
    rm -f -- "${raw:?}"
    if jq -e 'type == "array" and length > 0' "$tmp" >/dev/null 2>&1; then mv -f "$tmp" "$f"; else rm -f -- "${tmp:?}"; [[ -f $f ]] && touch "$f"; fi
  fi
  [[ -f $f ]] || echo '[]' >"$f"
  echo "$f"
}
# Filter, sort and page a catalog file. Counts are after the text filter and
# before the kind filter, so each tab shows what it holds.
CATALOG_QUERY_JQ='
  (($filter | ascii_downcase) as $q | map(select($q == "" or ((.title // "") | ascii_downcase | contains($q))))) as $hits
  | {counts: {all: ($hits | length), live: ([$hits[] | select(.kind == "live")] | length),
              stream: ([$hits[] | select(.kind == "stream")] | length), upload: ([$hits[] | select(.kind == "upload")] | length)},
     rows: ([$hits[] | select($kind == "all" or .kind == $kind)]
            | if $sort == "popular" then sort_by(-(if .live then .viewers * 1000 else .views end))
              elif $sort == "longest" then sort_by(-(.duration // 0))
              else sort_by((if .kind == "live" then 0 elif .kind == "upload" then 1 else 2 end), .order) end)}
  | .total = (.rows | length) | .entries = .rows[$offset:($offset + $limit)] | del(.rows)'
# One entry from the catalog, a creator cache or the bookmarks, by video id.
find_entry() {
  local id=$1
  jq -c --arg id "$id" 'first((.categories[].entries[]? // empty), empty | select(.id == $id))' "$(catalog_file)" 2>/dev/null | grep -v '^null$' && return 0
  bookmarks_json | jq -c --arg id "$id" 'first(.[] | select(.id == $id))' | grep -v '^null$' && return 0
  cat "$CHANNEL_CACHE"/*.json 2>/dev/null | jq -c --arg id "$id" 'first(.[]? | select(.id == $id))' 2>/dev/null | grep -v '^null$' | head -n1 && return 0
  return 1
}
now_entry() {
  [[ -f $STREAM ]] || { echo null; return 0; }
  jq -c '{id: .video_id, title, channel, url: .webpage_url, live: .is_live, channel_url: (.channel_url // ""), channel_id: (.channel_id // "")}' "$STREAM"
}
ANNOTATE_JQ='
  def chan_of($chans): (.channel_url // "") as $u | (.channel_id // "") as $cid
    | ([$chans[] | (.channel_id // "") as $chid | ((.handle // "") | ascii_downcase) as $h | (.url // "") as $curl
        | select(($chid != "" and ($cid == $chid or ($u | contains($chid))))
          or ($u != "" and ($u == $curl or ($h != "" and ($u | ascii_downcase | endswith("/" + $h))))))] | first) // null;
  def annotate($m; $c; $b; $now; $chans): (.id // "") as $vid | chan_of($chans) as $ch | . + {
    bookmarked: (($b | index([$vid])) != null), my_stars: ($m[$vid].stars // 0),
    avg: ($c[$vid].avg // 0), count: ($c[$vid].count // 0), plays: ($c[$vid].plays // 0),
    views: (.views // 0), viewers: (.viewers // 0), playing: ($vid == $now),
    creator: (if $ch then {id: $ch.id, name: $ch.name, bookmarked: $ch.bookmarked, builtin: $ch.builtin} else null end),
    creator_ref: (if $ch then $ch.id elif (.channel_id // "") != "" then .channel_id elif (.channel_url // "") != "" then .channel_url else .id end) };'

cmd_catalog() {
  local refresh=0 json=0 a f
  for a in "$@"; do case "$a" in --refresh) refresh=1 ;; --json) json=1 ;; *) die "catalog: unknown option $a" ;; esac; done
  f=$(catalog_file "$refresh")
  if (( json )); then cat "$f"; else jq -r '"catalog \(.generated) (\(.categories | length) categories, \([.categories[].entries | length] | add) entries)\(if .ratings_api == "" then ", community ratings not available yet" else "" end)", (.categories[] | "  \(.id): \(.name) — \(.entries | length)")' "$f"; fi
}

cmd_bookmark() {
  local sub=${1:-list} id title channel url entry ref extra='{}'
  shift || true
  case "$sub" in
    list)
      if [[ ${1:-} == --json ]]; then bookmarks_json; else bookmarks_json | jq -r '.[] | "\(.id)  \(.title) — \(.channel)"'; fi ;;
    add|toggle)
      ref=${1:-}
      if [[ -z $ref ]]; then
        [[ -f $STREAM ]] || die "nothing is playing to bookmark"
        id=$(jq -r .video_id "$STREAM")
      else
        id=$(video_id_of "$ref") || die "not a YouTube video: $ref"
      fi
      if [[ $sub == toggle ]] && bookmarks_json | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null; then
        bookmarks_json | jq --arg id "$id" '[.[] | select(.id != $id)]' | write_json "$BOOKMARKS"; echo "removed $id"; return 0
      fi
      if [[ -z $ref ]]; then
        title=$(jq -r .title "$STREAM"); channel=$(jq -r .channel "$STREAM"); url=$(jq -r .webpage_url "$STREAM")
        extra=$(jq -c '{live: (.is_live // false), channel_url: (.channel_url // ""), channel_id: (.channel_id // "")}' "$STREAM")
        if entry=$(find_entry "$id"); then extra=$(jq -c --slurpfile s "$STREAM" '{views: (.views // 0), viewers: (.viewers // 0), live: (.live // false),
          channel_url: (if (.channel_url // "") != "" then .channel_url else ($s[0].channel_url // "") end),
          channel_id: (if (.channel_id // "") != "" then .channel_id else ($s[0].channel_id // "") end)}' <<<"$entry"); fi
      elif entry=$(find_entry "$id"); then
        title=$(jq -r .title <<<"$entry"); channel=$(jq -r .channel <<<"$entry"); url=$(jq -r .url <<<"$entry")
        extra=$(jq -c '{views: (.views // 0), viewers: (.viewers // 0), live: (.live // false), channel_url: (.channel_url // ""), channel_id: (.channel_id // "")}' <<<"$entry")
      else
        url="https://www.youtube.com/watch?v=$id"
        IFS=$'\t' read -r title channel < <(timeout -k 5 "$YTDLP_TIMEOUT_SEC" yt-dlp --no-warnings --skip-download --no-playlist --print '%(title)s\t%(channel)s' -- "$url" 2>/dev/null | head -c "$YTDLP_MAX_BYTES" | head -n1 || true)
        [[ -n $title ]] || title=$id
      fi
      [[ -n $url && $url != null ]] || url="https://www.youtube.com/watch?v=$id"
      bookmarks_json | jq --arg id "$id" --arg t "$title" --arg c "${channel:-}" --arg u "$url" --argjson at "$(now)" --argjson x "$extra" \
        '[.[] | select(.id != $id)] + [({id: $id, title: $t, channel: $c, url: $u, added: $at} + $x)]' | write_json "$BOOKMARKS"
      echo "bookmarked $id" ;;
    remove)
      id=$(video_id_of "${1:-}") || die "remove wants a video id or URL"
      bookmarks_json | jq --arg id "$id" '[.[] | select(.id != $id)]' | write_json "$BOOKMARKS"; echo "removed $id" ;;
    *) die "bookmark: list, add, remove or toggle" ;;
  esac
}

# Send one rating to the API (or delete it with 0 stars). Quiet when there is
# no API, when sharing is off, or when offline: the local file keeps
# synced=false and `ratings --refresh` tries again.
sync_rating() {
  local id=$1 stars=$2 api iid out
  [[ $(cfg share_ratings) == true ]] || return 0
  api=$(ratings_api) || return 0
  iid=$(install_id)
  if (( stars == 0 )); then
    out=$(jq -nc --arg i "$iid" --arg v "$id" '{install_id: $i, video_id: $v}' | fetch -X DELETE -H 'content-type: application/json' --data @- "$api/v1/rate" 2>/dev/null) || return 1
  else
    out=$(jq -nc --arg i "$iid" --arg v "$id" --argjson s "$stars" '{install_id: $i, video_id: $v, stars: $s}' | fetch -X POST -H 'content-type: application/json' --data @- "$api/v1/rate" 2>/dev/null) || return 1
    my_ratings_json | jq --arg id "$id" 'if .[$id] then .[$id].synced = true else . end' | write_json "$MY_RATINGS"
  fi
  if jq -e '.video_id' <<<"$out" >/dev/null 2>&1; then
    mkdir -p "$CACHE_DIR"
    json_file_or "$RATINGS_CACHE" 'type == "object"' '{}' | jq --argjson r "$out" '.[$r.video_id] = {avg: $r.avg, count: $r.count}' | write_json "$RATINGS_CACHE"
  fi
}
# One "play" per install, video and day, when the stream changes to another
# video (the API ignores repeats). Same opt-out as the stars.
report_play() {
  local id=$1 api iid
  (LC_ALL=C; [[ $id =~ ^[A-Za-z0-9_-]{11}$ ]]) || return 0
  [[ $(cfg share_ratings) == true ]] || return 0
  api=$(ratings_api) || return 0
  iid=$(install_id)
  jq -nc --arg i "$iid" --arg v "$id" '{install_id: $i, video_id: $v}' \
    | curl -fsS --max-time 4 -A "omarchy-zen/$VERSION" -X POST -H 'content-type: application/json' --data @- "$api/v1/play" >/dev/null 2>&1 || true
}
sync_pending() {
  local id stars
  while IFS=$'\t' read -r id stars; do [[ -n $id ]] && sync_rating "$id" "$stars" || true; done < <(my_ratings_json | jq -r 'to_entries[] | select(.value.synced != true) | "\(.key)\t\(.value.stars)"')
}
cmd_rate() {
  local id stars=${2:-}
  id=$(video_id_of "${1:-}") || die "rate wants a video id or URL, then stars 1..5 (0 removes)"
  [[ $stars =~ ^[0-5]$ ]] || die "stars 1..5 (0 removes)"
  mkdir -p "$CONFIG_DIR"
  if (( stars == 0 )); then my_ratings_json | jq --arg id "$id" 'del(.[$id])' | write_json "$MY_RATINGS"
  else my_ratings_json | jq --arg id "$id" --argjson s "$stars" --argjson at "$(now)" '.[$id] = {stars: $s, at: $at, synced: false}' | write_json "$MY_RATINGS"; fi
  sync_rating "$id" "$stars" || true
  echo "$id: $stars"
}
cmd_ratings() {
  local refresh=0 json=0 a
  for a in "$@"; do case "$a" in --refresh) refresh=1 ;; --json) json=1 ;; *) die "ratings: unknown option $a" ;; esac; done
  (( refresh )) && sync_pending
  if (( json )); then community_ratings "$refresh"
  elif ! ratings_api >/dev/null; then echo "community ratings are not available yet (no ratings_api in the catalog)"
  else community_ratings "$refresh" | jq -r 'to_entries | sort_by(-.value.avg) | .[] | "\(.key)  \(.value.avg) (\(.value.count))"'; fi
}

# The creator to act on: REF as given, or the creator of what is playing.
channel_ref_default() {
  local r=${1:-}
  if [[ -z $r ]]; then
    [[ -f $STREAM ]] || die "nothing is playing; give a channel URL, @handle or video link"
    r=$(jq -r 'if (.channel_handle // "") != "" then .channel_handle elif (.channel_id // "") != "" then .channel_id else (.channel_url // "") end' "$STREAM")
    [[ -n $r ]] || r=$(jq -r .video_id "$STREAM")
  fi
  echo "$r"
}
channel_save() { # channel_save REF -> prints the saved record
  local ref=$1 rec known
  if known=$(find_channel "$ref") && [[ $(jq -r '.channel_id // ""' <<<"$known") =~ ^UC ]]; then
    rec=$(jq -c '{id, name, url, channel_id, handle, followers}' <<<"$known")
  elif [[ -n ${known:-} ]]; then
    rec=$(channel_resolve "$(jq -r .url <<<"$known")") || die "could not reach YouTube to look up $ref"
  else
    rec=$(channel_resolve "$ref") || die "could not find that creator on YouTube: $ref"
  fi
  mkdir -p "$CONFIG_DIR"
  my_channels_json | jq --argjson r "$rec" --argjson at "$(now)" '
    [.[] | select((.channel_id // "") != $r.channel_id and ((.id // "") | ascii_downcase) != ($r.id | ascii_downcase))] + [$r + {added: $at}]' \
    | write_json "$MY_CHANNELS"
  find_channel "$(jq -r .channel_id <<<"$rec")"
}
channel_unsave() { # channel_unsave RECORD_JSON
  local rec=$1 key
  my_channels_json | jq --argjson r "$rec" '[.[] | select(((.channel_id // "") == "" or .channel_id != ($r.channel_id // ""))
      and ((.id // "") | ascii_downcase) != (($r.id // "") | ascii_downcase))]' | write_json "$MY_CHANNELS"
  key=$(channel_key "$rec")
  if [[ $(jq -r '.builtin // false' <<<"$rec") != true && $key =~ ^[A-Za-z0-9._-]+$ ]]; then rm -f -- "${CHANNEL_CACHE:?}/$key.v2.json"; fi
  return 0
}
cmd_channel() {
  local sub=${1:-list} ref="" rec json=0 a
  shift || true
  case "$sub" in
    list)
      if [[ ${1:-} == --json ]]; then channels_json
      else channels_json | jq -r '.[] | "\(if .bookmarked then "★" else " " end) \(.id)  \(.name)  \(.url)\(if .builtin then "  (built in)" else "" end)"'; fi ;;
    add|bookmark|toggle|remove|unbookmark)
      for a in "$@"; do case "$a" in --json) json=1 ;; *) ref=$a ;; esac; done
      ref=$(channel_ref_default "$ref")
      if [[ $sub == toggle ]]; then
        if rec=$(find_channel "$ref") && [[ $(jq -r .bookmarked <<<"$rec") == true ]]; then sub=remove; else sub=add; fi
      fi
      if [[ $sub == add || $sub == bookmark ]]; then
        rec=$(channel_save "$ref")
        if (( json )); then echo "$rec"; else jq -r '"bookmarked \(.id) (\(.name))"' <<<"$rec"; fi
      else
        rec=$(find_channel "$ref") || die "not a saved creator: $ref"
        channel_unsave "$rec"
        rec=$(find_channel "$(jq -r .id <<<"$rec")" || jq -c '. + {bookmarked: false}' <<<"$rec")
        if (( json )); then jq -c '. + {bookmarked: false}' <<<"$rec"
        else jq -r '"removed the bookmark on \(.id)\(if .builtin then " (it stays in the selector: built in)" else "" end)"' <<<"$rec"; fi
      fi ;;
    videos)
      ref=${1:-}; shift || true
      [[ -n $ref ]] || die "videos wants a creator"
      cmd_library --channel "$ref" "$@" ;;
    open)
      ref=$(channel_ref_default "${1:-}")
      rec=$(find_channel "$ref") || rec=$(channel_resolve "$ref") || die "unknown creator: $ref"
      setsid -f xdg-open "$(jq -r .url <<<"$rec")" >/dev/null 2>&1 </dev/null ;;
    *) die "channel: list, add, toggle, remove, videos or open" ;;
  esac
}

cmd_play() {
  local ref=${1:-} id entry url curl_
  [[ -n $ref ]] || die "play wants a video id, a video URL or a creator"
  if id=$(video_id_of "$ref"); then
    if entry=$(find_entry "$id"); then url=$(jq -r '.url // ""' <<<"$entry"); curl_=$(jq -r '.channel_url // ""' <<<"$entry"); fi
    [[ -n $url && $url != null ]] || url="https://www.youtube.com/watch?v=$id"
  elif valid_url "$ref"; then
    url=$ref
  else
    url=$(find_channel "$ref" | jq -r '.url // ""')
    [[ -n $url ]] || die "unknown creator: $ref (bookmark it first: channel add URL)"
  fi
  if ( cmd_set_url "$url" >/dev/null 2>&1 ); then cmd_resolve; return 0; fi
  # A live radio restarted under a new id: its channel's newest stream is the same thing.
  if [[ -n ${curl_:-} && $curl_ != null ]] && valid_url "$curl_" && ( cmd_set_url "$curl_" >/dev/null 2>&1 ); then
    echo "that video is gone; following its channel instead" >&2; cmd_resolve; return 0
  fi
  die "could not play $url"
}

cmd_library() {
  local json=0 refresh=0 category="" channel="" bookmarks=0 f now kind rec="null" catf=""
  local ckind=all csort=newest cfilter="" coffset=0 climit=30
  while (( $# )); do
    case "$1" in
      --json) json=1 ;; --refresh) refresh=1 ;; --bookmarks) bookmarks=1 ;;
      --category) category=${2:-}; shift ;; --channel) channel=${2:-}; shift ;;
      --kind) ckind=${2:-}; shift ;; --sort) csort=${2:-}; shift ;; --filter) cfilter=${2:-}; shift ;;
      --offset) coffset=${2:-}; shift ;; --limit) climit=${2:-}; shift ;;
      *) die "library: unknown option $1" ;;
    esac; shift
  done
  case "$ckind" in all|live|stream|upload) ;; *) die "--kind: all, live, stream or upload" ;; esac
  case "$csort" in newest|popular|longest) ;; *) die "--sort: newest, popular or longest" ;; esac
  [[ $coffset =~ ^[0-9]+$ && $climit =~ ^[0-9]+$ ]] || die "--offset and --limit want numbers"
  (( climit <= 500 )) || climit=500
  cfilter=${cfilter:0:100}
  f=$(catalog_file "$refresh")
  # Everything that can fail runs before the scratch folder exists.
  if [[ -n $channel ]] && (( ! bookmarks )); then
    rec=$(find_channel "$channel") || rec=$(channel_resolve "$channel" | jq -c '. + {bookmarked: false, builtin: false}') \
      || die "unknown creator: $channel"
    catf=$(channel_catalog "$rec" "$refresh")
  fi
  # What is playing: the configured video right away (set-url writes it before
  # the resolve finishes), the resolved stream for channel and playlist URLs.
  now=$(video_id_of "$(cfg url)" 2>/dev/null) || now=$(jq -r '.video_id // ""' "$STREAM" 2>/dev/null || true)
  # Everything goes to jq through files: a creator's catalog is far larger
  # than one command-line argument may be (128 KiB).
  mkdir -p "$CACHE_DIR"
  local d; d=$(mktemp -d "$CACHE_DIR/.lib.XXXXXX")
  community_ratings "$refresh" >"$d/community"; my_ratings_json >"$d/mine"; bookmarks_json >"$d/bm"; channels_json >"$d/chans"; now_entry >"$d/nowe"
  echo '{}' >"$d/query"
  if (( bookmarks )); then cp "$d/bm" "$d/entries"; kind=bookmarks
  elif [[ -n $catf ]]; then
    jq --arg kind "$ckind" --arg sort "$csort" --arg filter "$cfilter" --argjson offset "$coffset" --argjson limit "$climit" \
      "$CATALOG_QUERY_JQ" "$catf" >"$d/query" || echo '{"counts":{"all":0,"live":0,"stream":0,"upload":0},"total":0,"entries":[]}' >"$d/query"
    jq '.entries' "$d/query" >"$d/entries"; kind=channel
  else
    [[ -n $category ]] || category=$(jq -r '.categories[0].id // ""' "$f")
    jq -c --arg c "$category" 'first(.categories[] | select(.id == $c)) | .entries // []' "$f" >"$d/entries"; kind=category
  fi
  printf '%s' "$rec" >"$d/rec"
  local api_ok=false; ratings_api >/dev/null && api_ok=true
  local out=""
  out=$(jq -n --slurpfile entries "$d/entries" --slurpfile bm "$d/bm" --slurpfile mine "$d/mine" --slurpfile community "$d/community" \
    --slurpfile chans "$d/chans" --slurpfile nowe "$d/nowe" --slurpfile query "$d/query" --slurpfile rec "$d/rec" --slurpfile cat "$f" \
    --arg now "$now" --arg kind "$kind" --arg category "$category" --argjson api "$api_ok" \
    --arg ckind "$ckind" --arg csort "$csort" --arg cfilter "$cfilter" --argjson coffset "$coffset" --argjson climit "$climit" \
    "$ANNOTATE_JQ"'
    $bm[0] as $bm | $mine[0] as $mine | $community[0] as $community | $chans[0] as $chans | ($bm | map(.id)) as $bids
    | def ann: annotate($mine; $community; $bids; $now; $chans);
    { generated: ($cat[0].generated // ""), ratings_api_available: $api, kind: $kind, category: $category,
      channel: (if $rec[0] then $rec[0].id else "" end),
      categories: [$cat[0].categories[] | {id, name, count: (.entries | length),
        bookmarked: ([.entries[] | (.id // "") as $i | select(($bids | index([$i])) != null)] | length)}],
      channels: ($chans | map(. as $ch | . + {bookmarked_streams: ([$bm[] | select(
          ((.channel_id // "") != "" and .channel_id == $ch.channel_id)
          or ((.channel_url // "") != "" and ((.channel_url // "") == $ch.url or (($ch.channel_id // "") != "" and ((.channel_url // "") | contains($ch.channel_id)))))
          or ((.channel_url // "") == "" and (.channel // "") == $ch.name))] | length)})),
      creator: (if $rec[0] then ($rec[0] + ($query[0] | {counts, total}) + {kind: $ckind, sort: $csort, filter: $cfilter, offset: $coffset, limit: $climit}) else null end),
      saved_creators: [$chans[] | select(.bookmarked)],
      now: (if $nowe[0] then ($nowe[0] | ann) else null end),
      bookmarks: ($bm | map(ann)),
      entries: ($entries[0] | map(ann)) }') || out=""
  rm -f -- "${d:?}/community" "${d:?}/mine" "${d:?}/bm" "${d:?}/chans" "${d:?}/nowe" "${d:?}/query" "${d:?}/entries" "${d:?}/rec"
  rmdir -- "${d:?}" 2>/dev/null || true
  [[ -n $out ]] || die "could not build the library"
  if (( json )); then echo "$out"; return 0; fi
  jq -r '
    (if .kind == "channel" then "\(.creator.name) — \(.creator.total) of \(.creator.counts.all) (live \(.creator.counts.live), past streams \(.creator.counts.stream), uploads \(.creator.counts.upload))\(if .creator.bookmarked then ", bookmarked" else "" end)"
     else "\(.kind) \(.category) — \(.entries | length) entries" end)
      + (if .ratings_api_available then "" else " (community ratings not available yet)" end),
    (.entries[] | "  \(if .playing then "▶" else " " end)\(if .bookmarked then "★" else " " end) \(.id)  \(.title | .[0:60])  — \(.channel)\(if .live then "  [live]" else "" end)  \(if .my_stars > 0 then "you: \(.my_stars)" else "" end)\(if .count > 0 then "  all: \(.avg) (\(.count))" else "" end)"),
    (if .kind == "bookmarks" and (.saved_creators | length) > 0 then "creators:", (.saved_creators[] | "  ★ \(.id)  \(.name)") else empty end)' <<<"$out"
}

usage() { sed -n '3,41p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

main() {
  local cmd=${1:-help}; shift || true
  case "$cmd" in
    status) cmd_status "$@" ;;
    set-url) cmd_set_url "$@" ;;
    mode)
      case "${1:-}" in animated|still|off) ;; *) die "mode wants animated, still or off" ;; esac
      config_set mode "$(jq -n --arg m "$1" '$m')"; ipc reload ;;
    sound) config_set sound "$(onoff "${1:-}")"; ipc reload ;;
    volume)
      [[ ${1:-} =~ ^(0|1|0?\.[0-9]+|1\.0+)$ ]] || die "volume wants a number from 0 to 1"
      config_set volume "$1"; ipc reload ;;
    quality)
      case "${1:-}" in 480|720|1080) ;; *) die "quality wants 480, 720 or 1080" ;; esac
      config_set quality "$1"; rm -f "$STREAM"; ipc reload ;;
    daily-refresh) config_set daily_refresh "$(onoff "${1:-}")" ;;
    daily-theme) config_set daily_theme "$(onoff "${1:-}")" ;;
    fullscreen-pause) config_set pause_when_fullscreen "$(onoff "${1:-}")"; ipc reload ;;
    toggle-mode)
      if [[ $(cfg mode) == animated ]]; then config_set mode '"still"'; else config_set mode '"animated"'; fi
      ipc reload; cfg mode ;;
    position) cmd_position "$@" ;;
    pause) ipc pause ;;
    resume) ipc resume ;;
    resolve) cmd_resolve "$@" ;;
    still) cmd_still "$@" ;;
    theme) cmd_theme "$@" ;;
    daily) cmd_daily "$@" ;;
    open) cmd_open ;;
    suno) cmd_suno ;;
    library) cmd_library "$@" ;;
    play) cmd_play "$@" ;;
    bookmark) cmd_bookmark "$@" ;;
    rate) cmd_rate "$@" ;;
    ratings) cmd_ratings "$@" ;;
    channel) cmd_channel "$@" ;;
    catalog) cmd_catalog "$@" ;;
    share-ratings) config_set share_ratings "$(onoff "${1:-}")" ;;
    update-check) exec bash "$ROOT/lib/update.sh" check "$@" ;;
    update-dismiss) exec bash "$ROOT/lib/update.sh" dismiss "$@" ;;
    update-run) exec bash "$ROOT/lib/update.sh" run "$@" ;;
    version|--version) echo "$VERSION" ;;
    help|-h|--help) usage ;;
    *) echo "omarchy-zen: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
  esac
}
main "$@"
